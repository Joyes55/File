{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and role-based access control assignment.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the user."
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown in peer radar and file provenance."
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL from Google Auth."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "editor", "viewer"],
          "description": "Authorization role controlling vault permissions."
        },
        "deviceModel": {
          "type": "string",
          "description": "Detected client device label."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when profile or role was last updated."
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "VaultFileMetadata": {
      "title": "VaultFileMetadata",
      "description": "Firestore audit and ownership record for a categorized vault file.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique file identifier."
        },
        "name": {
          "type": "string",
          "description": "File name with extension."
        },
        "size": {
          "type": "number",
          "description": "File size in bytes."
        },
        "mimeType": {
          "type": "string",
          "description": "MIME type string."
        },
        "category": {
          "type": "string",
          "description": "Assigned file category."
        },
        "uploadedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO upload timestamp."
        },
        "uploadDate": {
          "type": "string",
          "description": "YYYY-MM-DD upload date string."
        },
        "ownerUid": {
          "type": "string",
          "description": "UID of the user who uploaded the file."
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the uploader."
        },
        "senderDevice": {
          "type": "string",
          "description": "Device label of the uploader."
        },
        "roomCode": {
          "type": "string",
          "description": "6-digit pairing room code."
        },
        "pinProtected": {
          "type": "boolean",
          "description": "Whether file requires a 4-digit PIN."
        },
        "pinned": {
          "type": "boolean",
          "description": "Whether file is pinned to the top of list and grid views."
        },
        "pinnedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the file was pinned to top."
        }
      },
      "required": [
        "id",
        "name",
        "size",
        "mimeType",
        "category",
        "uploadedAt",
        "uploadDate",
        "ownerUid",
        "senderName",
        "roomCode",
        "pinProtected"
      ]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Chronological room audit log record for file uploads, deletions, and category changes.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique activity log identifier."
        },
        "action": {
          "type": "string",
          "enum": [
            "upload",
            "delete",
            "category_change",
            "pin_toggle",
            "rename",
            "category_created",
            "download"
          ],
          "description": "Type of file or room operation performed."
        },
        "fileId": {
          "type": "string",
          "description": "Optional target file identifier."
        },
        "fileName": {
          "type": "string",
          "description": "Target file or category name."
        },
        "category": {
          "type": "string",
          "description": "Current or new category associated with the operation."
        },
        "previousCategory": {
          "type": "string",
          "description": "Previous category prior to a category change."
        },
        "actorName": {
          "type": "string",
          "description": "Display name of the user who triggered the operation."
        },
        "actorDevice": {
          "type": "string",
          "description": "Device model of the user."
        },
        "roomCode": {
          "type": "string",
          "description": "Pairing room code."
        },
        "details": {
          "type": "string",
          "description": "Human-readable audit summary."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the operation occurred."
        }
      },
      "required": ["id", "action", "fileName", "actorName", "roomCode", "details", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user authentication profiles and RBAC roles (admin, editor, viewer)."
    },
    "/vault_files/{fileId}": {
      "schema": {
        "$ref": "#/entities/VaultFileMetadata"
      },
      "description": "Stores ownership and categorization metadata for shared vault files."
    },
    "/activity_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/ActivityLog"
      },
      "description": "Stores chronological audit trail of file uploads, deletions, and category changes."
    }
  }
}
