rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches request.auth.uid)
    // Fields:
    //   - uid: string (required, immutable)
    //   - email: string (required, immutable)
    //   - displayName: string (required, 1..80 chars)
    //   - photoURL: string (optional, <= 500 chars)
    //   - role: string (required, 'admin' | 'editor' | 'viewer')
    //   - deviceModel: string (optional, <= 80 chars)
    //   - createdAt: string (required, immutable ISO timestamp)
    //   - updatedAt: string (required, ISO timestamp)
    //
    // Collection: vault_files
    // Document ID: {fileId}
    // Fields:
    //   - id: string (required, immutable)
    //   - name: string (required, 1..240 chars)
    //   - size: number (required, >= 0)
    //   - mimeType: string (required, <= 120 chars)
    //   - category: string (required, 1..80 chars)
    //   - uploadedAt: string (required, ISO timestamp)
    //   - uploadDate: string (required, YYYY-MM-DD)
    //   - ownerUid: string (required, immutable)
    //   - senderName: string (required, 1..80 chars)
    //   - senderDevice: string (optional, <= 80 chars)
    //   - roomCode: string (required, 1..20 chars)
    //   - pinProtected: boolean (required)
    //   - pinned: boolean (optional)
    //   - pinnedAt: string (optional, ISO timestamp)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == "joyesgrg555@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : (isBootstrapAdmin() ? 'admin' : 'editor');
    }

    function isAdmin() {
      return isBootstrapAdmin() || (isAuthenticated() && getUserRole() == 'admin');
    }

    function isEditorOrAdmin() {
      return isAdmin() || (isAuthenticated() && getUserRole() == 'editor');
    }

    function isValidRole(role) {
      return role in ['admin', 'editor', 'viewer'];
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        isValidRole(data.role) &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidVaultFile(data) {
      return data.keys().hasAll(['id', 'name', 'size', 'mimeType', 'category', 'uploadedAt', 'uploadDate', 'ownerUid', 'senderName', 'roomCode', 'pinProtected']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 120 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 240 &&
        data.size is number && data.size >= 0 && data.size <= 104857600 &&
        data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 120 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.uploadedAt is string && data.uploadedAt.size() <= 40 &&
        data.uploadDate is string && data.uploadDate.size() == 10 &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        data.roomCode is string && data.roomCode.size() >= 1 && data.roomCode.size() <= 20 &&
        data.pinProtected is bool &&
        (!('encrypted' in data) || data.encrypted is bool) &&
        (!('encryptionAlgo' in data) || (data.encryptionAlgo is string && data.encryptionAlgo.size() <= 120)) &&
        (!('encryptionIv' in data) || (data.encryptionIv is string && data.encryptionIv.size() <= 120)) &&
        (!('encryptionSalt' in data) || (data.encryptionSalt is string && data.encryptionSalt.size() <= 120)) &&
        (!('encryptionFingerprint' in data) || (data.encryptionFingerprint is string && data.encryptionFingerprint.size() <= 160)) &&
        (!('encryptedPayload' in data) || (data.encryptedPayload is string && data.encryptedPayload.size() <= 60000)) &&
        (!('keyHint' in data) || (data.keyHint is string && data.keyHint.size() <= 240));
    }

    // Users collection: RBAC profiles
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId) &&
        isValidUserProfile(request.resource.data) &&
        request.resource.data.uid == request.auth.uid;

      allow update: if isAuthenticated() &&
        isValidUserProfile(request.resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (isAdmin() || isOwner(userId));

      allow delete: if isAdmin();
    }

    // Vault Files metadata collection
    match /vault_files/{fileId} {
      allow read: if isAuthenticated();

      allow create: if isEditorOrAdmin() &&
        isValidVaultFile(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid;

      allow update: if isEditorOrAdmin() &&
        isValidVaultFile(request.resource.data) &&
        request.resource.data.id == resource.data.id;

      allow delete: if isAdmin() || (isEditorOrAdmin() && resource.data.ownerUid == request.auth.uid);
    }

    // Room Activity Audit Log collection
    match /activity_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isEditorOrAdmin() &&
        request.resource.data.keys().hasAll(['id', 'action', 'fileName', 'actorName', 'roomCode', 'details', 'timestamp']) &&
        request.resource.data.id is string &&
        request.resource.data.fileName is string &&
        request.resource.data.actorName is string &&
        request.resource.data.roomCode is string &&
        request.resource.data.details is string &&
        request.resource.data.timestamp is string;
      allow update, delete: if isAdmin();
    }

    function isValidSharedBundle(data) {
      return data.keys().hasAll(['id', 'archiveName', 'roomCode', 'createdBy', 'ownerUid', 'createdAt', 'expiresAt', 'ttlMinutes', 'fileIds', 'fileNames', 'fileCount', 'totalBytes', 'downloads', 'revoked']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 120 &&
        data.archiveName is string && data.archiveName.size() >= 1 && data.archiveName.size() <= 240 &&
        data.roomCode is string && data.roomCode.size() >= 1 && data.roomCode.size() <= 20 &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 80 &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.expiresAt is string && data.expiresAt.size() <= 40 &&
        data.ttlMinutes is number && data.ttlMinutes >= 1 && data.ttlMinutes <= 43200 &&
        data.fileIds is list && data.fileIds.size() >= 1 && data.fileIds.size() <= 100 &&
        data.fileNames is list && data.fileNames.size() >= 1 && data.fileNames.size() <= 100 &&
        data.fileCount is number && data.fileCount >= 1 && data.fileCount <= 100 &&
        data.totalBytes is number && data.totalBytes >= 0 &&
        data.downloads is number && data.downloads >= 0 &&
        data.revoked is bool &&
        (!('createdByDevice' in data) || (data.createdByDevice is string && data.createdByDevice.size() <= 80)) &&
        (!('bundleZipBytes' in data) || (data.bundleZipBytes is number && data.bundleZipBytes >= 0)) &&
        (!('shareUrl' in data) || (data.shareUrl is string && data.shareUrl.size() <= 500)) &&
        (!('downloadUrl' in data) || (data.downloadUrl is string && data.downloadUrl.size() <= 500));
    }

    // Expiring Multi-File Share Bundles collection
    match /shared_bundles/{bundleId} {
      allow get: if true;
      allow list: if isAuthenticated();

      allow create: if isEditorOrAdmin() &&
        isValidSharedBundle(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid;

      allow update: if isValidSharedBundle(request.resource.data) &&
        request.resource.data.id == resource.data.id &&
        (isEditorOrAdmin() ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']) &&
          request.resource.data.downloads == resource.data.downloads + 1));

      allow delete: if isAdmin() || (isEditorOrAdmin() && resource.data.ownerUid == request.auth.uid);
    }
  }
}
